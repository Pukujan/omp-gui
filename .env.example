# omp-gui server config — copy to .env (gitignored). Never commit real secrets.

# login (single user)
OMP_GUI_USER=
OMP_GUI_PASS_PLAINTEXT=
# random 32+ bytes; signs session cookies
OMP_GUI_SESSION_SECRET=

# server
OMP_GUI_PORT=8790
OMP_GUI_HOST=0.0.0.0
# absolute path to omp binary (default: omp on PATH)
#OMP_BIN=

# optional
#OMP_GUI_MAX_SESSIONS=8
#OMP_GUI_ORIGIN=https://omp.design-bakery.com

# image generation (GUI image button + /api/image). Values mirror the ckff
# provider keys used by the local omp config; the token is never sent to the browser.
#ckff-image-url=https://ckffai.com/v1/images/generations
#ckff-cortex-image-generation=
#ckff-cortex-image-generation-model=gpt-image-2.5
# comma-separated models tried when the primary is out of quota / has no channel
#CKFF_IMAGE_FALLBACKS=gemini-3.1-flash-image

# model picker ranking engine (Inference Recommendation Engine checkout).
# When the path is absent the picker falls back to local price/throughput ordering.
#IRE_ROOT=D:/claude/inference-recommendation-engine
